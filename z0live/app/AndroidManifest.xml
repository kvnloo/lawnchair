<?xml version="1.0" encoding="utf-8"?>
<!-- z0live companion: the one app that owns the mic service, accessibility service, assistant role and pairing. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The flashlight tool needs the camera permission; the app still installs on camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <package android:name="com.tailscale.ipn" />
        <package android:name="com.noop.whoop.debug" />
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.ASSIST" /></intent>
        <!-- LauncherApps.getActivityList for the open-app tool: launcher activities only, not QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/z0live_title"
        android:icon="@drawable/z0live_mic"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/z0live_data_extraction_rules"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="app.lawnchair.zer0.voice.z0live.Z0LiveActivity"
            android:exported="true" android:launchMode="singleTop" android:label="@string/z0live_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="app.lawnchair.zer0.voice.z0live.Z0LiveActivity$LinkActivity"
            android:label="@string/z0live_title" android:noHistory="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="z0live" android:host="voice" />
                <data android:scheme="z0live" android:host="pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- The launcher contract: Lawnchair, Detent and adb send z0live.action.START / MUTE / END here. -->
        <activity android:name="app.lawnchair.zer0.voice.z0live.Z0LiveCommandActivity"
            android:noHistory="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:exported="true">
            <intent-filter>
                <action android:name="z0live.action.START" />
                <action android:name="z0live.action.MUTE" />
                <action android:name="z0live.action.END" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service android:name="app.lawnchair.zer0.voice.z0live.Z0LiveService"
            android:exported="false" android:stopWithTask="false"
            android:foregroundServiceType="microphone" />
        <service android:name="app.lawnchair.zer0.voice.z0live.Z0LiveInboxNotifications"
            android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name="app.lawnchair.zer0.voice.z0live.Z0LiveAccessibilityService"
            android:exported="false" android:label="@string/z0live_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/z0live_accessibility_service" />
        </service>
        <receiver android:name="app.lawnchair.zer0.voice.z0live.Z0LiveControlProbe"
            android:exported="true" android:permission="android.permission.DUMP" />
        <service android:name="app.lawnchair.zer0.voice.z0live.Z0LiveTile"
            android:exported="true" android:icon="@drawable/z0live_mic"
            android:label="@string/z0live_title" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name="app.lawnchair.zer0.voice.z0live.Z0LiveAssistantService"
            android:exported="true" android:label="@string/z0live_title"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/z0live_assistant" />
        </service>
        <service android:name="app.lawnchair.zer0.voice.z0live.Z0LiveAssistantSessionService"
            android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name="app.lawnchair.zer0.voice.z0live.Z0LiveRecognitionService"
            android:exported="true" android:label="@string/z0live_title">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
